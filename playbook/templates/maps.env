CLUSTER_ID={{ asa_cluster_name }}
MAP_NAME=${SERVER_MAP/_WP}
SESSION_NAME="${CLUSTER_ID} ${MAP_NAME}"
MAX_PLAYERS={{ asa_max_player }}

# Comment to disable password
{% if not asa_server_password is defined %}#{% endif %}SERVER_PASSWORD={{ asa_server_password|default('reallysecure') }}
{% if not asa_admin_password is defined %}#{% endif %}ARK_ADMIN_PASSWORD={{ asa_admin_password|default('supersecret') }}

# Comment to enable BattlEye
DISABLE_BATTLEYE=1

# Mods: Please provide a comma seperated list of the curse-forge modIDs and uncomment the MODS arg
# e.g. MODS=931872,931338
MODS={{ asa_mods.keys() | list | join(',') }}


# Extra arguments
#ARK_EXTRA_OPTS=?ServerCrosshair=true?OverrideStructurePlatformPrevention=true?OverrideOfficialDifficulty=5.0?ShowFloatingDamageText=true?AllowFlyerCarryPvE=true
#ARK_EXTRA_DASH_OPTS=-ForceAllowCaveFlyers -ForceRespawnDinos -AllowRaidDinoFeeding=true -ActiveEvent=Summer
ARK_EXTRA_OPTS={% if asa_extra_opts %}?{% endif %}{{ asa_extra_opts | join('?') }}
ARK_EXTRA_DASH_OPTS={% if asa_extra_dash_opts %}-{% endif %}{{ asa_extra_dash_opts | join(' -') }}
