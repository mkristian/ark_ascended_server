#!/bin/bash

ARK_HOME=$HOME/.config/ark
source $ARK_HOME/manager.env
ARK_STATE=$HOME/ark_backup/$CLUSTER_ID
ALL=$(find $ARK_HOME/* -type d | sed 's|.*/\([^/]*\)|\1|' | xargs echo)
CLUSTER=$(find $ARK_STATE -name cluster | sed -e 's|/cluster||' -e 's|.*/\([^/]*\)|\1|' | xargs echo)

_B="\033[0;1;30m"
_R="\033[0;1;31m"
_G="\033[0;1;32m"
_Y="\033[0;1;33m"
_B="\033[0;1;34m"
_P="\033[0;1;35m"
_C="\033[0;1;36m"
_W="\033[0;1;37m"
__="\033[0m"

log() {
  echo -e "$_B$CLUSTER_ID$__ $_Y$map$__ $*"
}

fail_on_max(){
  let num=$(find $ARK_STATE/ -name cluster | wc -l)
  if [[ ! $num < $((CLUSTER_MAX_SIZE)) ]]
  then
    echo -e "cluster can not have more then $_R${CLUSTER_MAX_SIZE} members$__"
    echo -e "see $ARK_HOME/manager.env"
    exit 123
  fi
}

state(){
  if [[ -z $1 ]]
  then
    echo -e "${_R}NO map name given"
    exit 123
  fi
  map=$1
  shift
  if [[ ! -d $ARK_STATE/$map ]]
  then
    log "${_R}not a map name$__"
    exit 123
  fi 
  IN_CLUSTER=$ARK_STATE/$map/cluster
  IS_RUNNING=$ARK_STATE/$map/running
}

show(){
  for map in $ALL
  do
    log $(if [[ $CLUSTER =~ $map ]]
	  then
            echo -n "$_P in cluster"
	    state $map
            if [[ -f $IS_RUNNING ]]
            then
              echo "$__ is$_G running$__"
            else 
              echo "$__ is$_R stopped$__"
            fi
	  else
            echo -e "$_R not in cluster$__"
	  fi)
  done
}
