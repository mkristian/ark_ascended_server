#!/bin/bash

ARK_HOME=$HOME/.config/ark
source $ARK_HOME/manager.env

_D="\033[0;1;30m"
_R="\033[0;1;31m"
_G="\033[0;1;32m"
_Y="\033[0;1;33m"
_B="\033[0;1;34m"
_P="\033[0;1;35m"
_C="\033[0;1;36m"
_W="\033[0;1;37m"
__="\033[0m"

log() {
  echo -e "- $_Y$map$__ $*"
}

fail_on_max(){
  let num=$(find $ARK_HOME/ -name cluster | wc -l)
  if [[ ! $num < $((CLUSTER_MAX_SIZE)) ]]
  then
    echo -e "cluster can not have more then $_R${CLUSTER_MAX_SIZE} members$__"
    echo -e "see $ARK_HOME/manager.env"
    exit 123
  fi
}

cluster() {
  find $ARK_HOME -maxdepth 2 -name cluster -type f | sed -e 's|/cluster||' -e 's|.*/\([^/]*\)|\1|' | xargs echo
}

all(){
  find $ARK_HOME/* -maxdepth 1 -type d | grep -v Saved |  sed 's|.*/\([^/]*\)|\1|' | xargs echo
}

state(){
  if [[ -z $1 ]]
  then
    echo -e "${_R}NO map name given$__"
    exit 123
  fi
  map=$1
  shift
  if [[ ! -d $ARK_HOME/$map ]]
  then
    log "${_R}not a map name$__"
    exit 123
  fi
  IN_CLUSTER=$ARK_HOME/$map/cluster
  IS_RUNNING=$ARK_HOME/$map/running
}

show(){
  echo -e "$_B$CLUSTER_ID$__"
  for map in $(all)
  do
    log $(if [[ $(cluster) =~ $map ]]
	  then
            echo -n "${_P}in cluster"
	    state $map
            if [[ -f $IS_RUNNING ]]
            then
              echo "$__ is$_G running$__"
            else 
              echo "$__ is$_R stopped$__"
            fi
	  else
            echo -e "$_R not in cluster$__"
	  fi)
  done
}
